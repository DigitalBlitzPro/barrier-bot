# Copy to .env for local use. NEVER commit real values. In production these are Railway variables.

# Supabase Postgres (session pooler connection string). Tables live in the "barrier" schema (schema.sql).
SUPABASE_DB_URL=

# The secret part of the Bot URL. GHL's custom value "BARRIER | Bot URL" is set to
# https://<railway-app>/hook/<this value>. At least 24 random characters.
BARRIER_WEBHOOK_SECRET=

# 32 random bytes, base64. Encrypts the software API keys clients paste into the Software Connect form.
BARRIER_SECRETS_KEY=

# Added as the bots are built:
# ANTHROPIC_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GHL_AGENCY_TOKEN=      (creates client sub-accounts from the snapshot)
# GHL_LOCATION_TOKEN=    (writes fields and tags on contacts in the Digital Blitz account)
# TODOIST_API_TOKEN=     (exceptions for Kenny)
